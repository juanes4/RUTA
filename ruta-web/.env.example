# Copia este archivo como .env para activar la IA de la etapa T2 (preguntas del simulador y resumen para el líder).
# Sin clave, el simulador usa las preguntas base y todo lo demás funciona igual.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.6-flash)
# RUTA_MODELO_IA=gemini-3.6-flash
# Opcional: mínimo de personas por video para que el resumen use IA (por defecto 5, como el termómetro)
# RUTA_MINIMO_GRUPO_IA=5
