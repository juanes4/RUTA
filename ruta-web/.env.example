# Variables del servidor de RUTA. Copia este archivo como .env (en esta misma carpeta, ruta-web/)
# y llena los valores. El .env no se sube al repositorio.
# Nunca les pongas el prefijo VITE_: con ese prefijo Vite las mandaría al navegador.

# Clave de la API de Gemini (Google AI Studio).
GEMINI_API_KEY=

# Opcional: segunda clave. Se usa solo si la principal falla (rechazada, sin cuota, saturada o sin respuesta).
GEMINI_API_KEY_RESPALDO=

# Nombre del modelo de Gemini que se quiere usar. Se cambia aquí, sin tocar el código.
GEMINI_MODEL=

# Opcional: si GEMINI_MODEL no funciona (saturado, sin cuota, sin respuesta), se prueban estos
# en orden, separados por comas, del más al menos potente. Ejemplo: gemini-3.7-flash,gemini-3.5-flash-lite
GEMINI_MODELOS_RESPALDO=

# Opcional: cuánto razona Gemini 3 antes de responder: minimal, low, medium o high ("auto" deja el del modelo).
# Por omisión low: el copiloto responde mucho más rápido y sus tareas son acotadas.
GEMINI_RAZONAMIENTO=

# Solo con el valor "permitido" el servidor envía a Gemini respuestas reales del buzón.
# Déjalo vacío hasta tener un contrato de datos (Ley 1581 y transmisión internacional).
RUTA_IA_DATOS_REALES=

# Opcional: hosts extra para Vite, separados por comas (por ejemplo, el de un túnel para mostrar la app desde otro equipo).
RUTA_HOSTS=

# Opcional (IA de la etapa T2: preguntas del simulador y resumen para el líder). Usa GEMINI_API_KEY.
# Modelo a usar (por defecto gemini-3.6-flash):
# RUTA_MODELO_IA=gemini-3.6-flash
# Mínimo de personas por video para que el resumen use IA (por defecto 5, como el termómetro):
# RUTA_MINIMO_GRUPO_IA=5
